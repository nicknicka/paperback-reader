{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Paperback Reader",
  "version": "0.1.0",
  "identifier": "com.nickxiao.paperbackreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Paperback Reader",
        "width": 1180,
        "height": 780,
        "minWidth": 300,
        "minHeight": 207
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
